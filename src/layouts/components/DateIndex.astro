---
const Event = [
    {
        date: "Wednesday, 19th August 2026",
        name: "Conference – Hybrid",
        place: "Auditorium Hall, 2nd Floor - Universitas Trilogi",
        time: "08.00 am - 12.00 pm",
        class: "timeline-start md:text-end md:text-xl mb-10"
    },
    
];
---

<ul class="timeline timeline-vertical text-black">
  <li class="flex flex-col items-center text-center">
    
    <!-- ICON -->
    <div class="timeline-middle">
      <svg xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-5 w-5">
        <path fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
          clip-rule="evenodd"></path>
      </svg>
    </div>

    <!-- CONTENT CENTER -->
    <div class="text-center mb-10 max-w-xl">
      <time class="text-lg lg:text-2xl font-semibold">
        Wednesday, 19th August 2026
      </time>

      <div class="md:text-xl text-sm font-bold mt-2">
        Conference - Hybrid
      </div>

      <div class="md:text-base text-sm mt-1">
        Auditorium Hall, 2nd Floor - Universitas Trilogi & Zoom Cloud Meetings
      </div>
    </div>

    <hr class="w-1/2 mx-auto" />
  </li>
</ul>
