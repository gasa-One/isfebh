---
import Layout from "../layouts/partials/Layout.astro";
import Container from "../layouts/partials/Container.astro";
import Contact from "../layouts/components/ContactSub.astro";
import ContactContainer from "../layouts/components/ContactContainer.astro";
import Heading2 from "../layouts/components/Heading2.astro";
import HeadingMini from "../layouts/components/HeadingMini.astro";
---

<Layout title="Co-Host">

  <Container>
    <Heading2 text="Co-Host Universities" />

    <!-- LOADING -->
    <div id="loading" class="text-center py-10 text-gray-500">
      Loading co-host data...
    </div>

    <!-- FLEX GRID -->
    <div id="cohost-container"
         class="hidden flex flex-wrap justify-center gap-10 my-10">
    </div>

    <HeadingMini text="More to be announced" />
  </Container>

  <!-- CONTACT -->
  <Container>
    <Heading2 text="Contact Us" />
    <ContactContainer>
      <Contact
        media="WhatsApp (Mrs. Ratih)"
        class="fa-brands fa-whatsapp"
        text="+62 823-2866-8422"
        href="https://wa.me/6282328668422"
      />
      <Contact
        media="WhatsApp (Mr. Ricky)"
        class="fa-brands fa-whatsapp"
        text="+62 812-8797-1081"
        href="https://wa.me/6281287971081"
      />
      <Contact
        media="Email"
        class="fa-regular fa-envelope"
        text="internationalseminar@trilogi.ac.id"
        href="mailto:internationalseminar@trilogi.ac.id"
      />
    </ContactContainer>
  </Container>

</Layout>

<script>
  const container = document.getElementById("cohost-container");
  const loading = document.getElementById("loading");

  // ✅ FALLBACK DATA (kalau API error / kosong)
  const dummyData = [
  
    {
      nama: "Universitas Katolik Indonesia Atma Jaya Jakarta",
      logo: "https://upload.wikimedia.org/wikipedia/id/8/8c/Logo_Atma_Jaya.png",
      url: "#"
    }
  ];

  function renderData(data) {
    container.innerHTML = data
      .sort((a, b) => a.nama.localeCompare(b.nama))
      .map(item => `
        <a href="${item.url}" target="_blank"
           class="group w-[260px] bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-lg hover:-translate-y-1 transition duration-300 text-center overflow-hidden">

          <!-- LOGO -->
          <div class="h-[140px] flex items-center justify-center bg-gray-50 p-4">
            <img class="max-h-full object-contain group-hover:scale-110 transition duration-300"
                 src="${item.logo}" />
          </div>

          <!-- NAME -->
          <div class="p-4">
            <h5 class="text-sm font-medium text-gray-700 group-hover:text-blue-600 transition leading-snug">
              ${item.nama}
            </h5>
          </div>

        </a>
      `).join("");
  }

  async function fetchCohost() {
    try {
      const res = await fetch("https://data.jetadmin.app/projects/inncafa/prod/googlesheets_k55r/models/co-host", {
        headers: {
          Authorization: "Bearer q1ZPkHTDtpqjsmyyspYZ4B2ZK0nq0rqwliw4mCwT"
        }
      });

      const data = await res.json();

      loading.style.display = "none";
      container.classList.remove("hidden");

      if (data.results && data.results.length > 0) {
        renderData(data.results);
      } else {
        renderData(dummyData);
      }

    } catch (err) {
      console.error(err);
      loading.style.display = "none";
      container.classList.remove("hidden");

      // fallback tampilkan dummy
      renderData(dummyData);
    }
  }

  fetchCohost();
</script>