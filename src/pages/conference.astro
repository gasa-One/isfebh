---
import Jumbotron from "../layouts/partials/Jumbotron.astro";
import Paragraph from "../layouts/components/Paragraph.astro";
import Layout from "../layouts/partials/Layout.astro";
import Container from "../layouts/partials/Container.astro";
import Contact from "../layouts/components/ContactSub.astro";
import ContactContainer from "../layouts/components/ContactContainer.astro";
import Heading2 from "../layouts/components/Heading2.astro";
import Heading3 from "../layouts/components/Heading3.astro";
import DateSeminar from "../layouts/components/DateSeminar.astro";
import PriceSeminar from "../layouts/components/PriceSeminar.astro";
import Button from "../layouts/helpers/Button.astro";
import ButtonContainer from "../layouts/helpers/ButtonContainer.astro";

const openingSpeakers = [
  {
    name: "Prof. Dr. Pramono Hari Adi, MS.",
    position: "Rector, Trilogi University",
    image: "https://via.placeholder.com/200"
  }
];

const keynoteSpeakers = [
  {
    name: "Prof. Brian Yuliarto, S.T., M.Eng., Ph.D",
    position: "International Expert",
    image: "https://via.placeholder.com/200"
  }
];

const panelis = [
  {
    name: "Assoc Prof Szekee KOH, Ph.D (Singapore)",
    position: "Accounting Expert",
    image: "https://via.placeholder.com/200"
  },
  {
    name: "Prof. Dr. Hamdan Daniel, Ph.D (Malaysia)",
    position: "Finance Specialist",
    image: "https://via.placeholder.com/200"
  },
  {
    name: "Prof. Dr. Siham El Kafafi (New Zealand)",
    position: "Accounting Expert",
    image: "https://via.placeholder.com/200"
  }
];
---

<Layout title="Conference">

  <!-- JUMBOTRON -->
  <Jumbotron src="/jumbotron/seminar-3.webp" />

  <!-- DESCRIPTION -->
  <Container>
    <Paragraph
      text="This conference gathers academics and professionals to bridge theory and practice in accounting, finance, and business."
    />
  </Container>

  <!-- OPENING -->
  <Container>
    <Heading2 text="Opening Speeches" />
    {
      openingSpeakers.map((s) => (
        <div class="flex flex-col lg:flex-row items-center gap-6 my-4 w-3/4 mx-auto">
          <img class="w-40 rounded-lg shadow" src={s.image} />
          <div>
            <h2 class="text-xl font-bold">{s.name}</h2>
            <p class="text-gray-500">{s.position}</p>
          </div>
        </div>
      ))
    }
  </Container>

  <!-- KEYNOTE -->
  <Container>
    <Heading2 text="Keynote Speeches" />
    {
      keynoteSpeakers.map((s) => (
        <div class="flex flex-col lg:flex-row items-center gap-6 my-4 w-3/4 mx-auto">
          <img class="w-40 rounded-lg shadow" src={s.image} />
          <div>
            <h2 class="text-xl font-bold">{s.name}</h2>
            <p class="text-gray-500">{s.position}</p>
          </div>
        </div>
      ))
    }
  </Container>

  <!-- SPEAKER -->
  <Container>
    <Heading2 text="Panelis" />
{
      panelis.map((s) => (
        <div class="flex flex-col lg:flex-row items-center gap-6 my-4 w-3/4 mx-auto">
          <img class="w-40 rounded-lg shadow" src={s.image} />
          <div>
            <h2 class="text-xl font-bold">{s.name}</h2>
            <p class="text-gray-500">{s.position}</p>
          </div>
        </div>
      ))
    }


  </Container>




  <!-- TIMELINE -->
<Container>
  <Heading2 text="Timeline" />

  <div class="relative max-w-4xl mx-auto mt-8">

    <!-- GARIS TENGAH -->
    <div class="absolute left-1/2 top-0 h-full w-1 bg-gray-300 -translate-x-1/2"></div>

    <!-- ITEM 1 -->
    <div class="mb-10 flex justify-start">
      <div class="w-1/2 pr-8 text-right">
        <p class="italic text-lg">Wednesday, 19th August 2026</p>
        <p class="font-semibold">Conference – Hybrid</p>
        <p>Auditorium Hall, 2nd Floor – Universitas Trilogi & Zoom Cloud Meetings</p>
      </div>

  </div>
</Container>

 <!-- PRICE -->
<Container>
  <Heading2 text="Price" />

  <div class="max-w-4xl mx-auto mt-6">
    <table class="w-full text-left border-collapse">

      <!-- HEADER -->
      <thead>
        <tr class="border-b">
          <th class="py-3 font-bold">CATEGORY</th>
          <th class="py-3 font-bold">OFFLINE</th>
          <th class="py-3 font-bold">ONLINE</th>
        </tr>
      </thead>

      <!-- BODY -->
      <tbody>

        <tr class="border-b">
          <td class="py-4">
            Lecturer/Practitioner/Public/Student S2–S3
          </td>
          <td class="py-4">
            USD 17 / IDR 250.000
          </td>
          <td class="py-4">
            USD 13 / IDR 200.000
          </td>
        </tr>

        <tr>
          <td class="py-4">
            Student D3/D4/S1
          </td>
          <td class="py-4">
            USD 4 / IDR 50.000
          </td>
          <td class="py-4">
            USD 4 / IDR 50.000
          </td>
        </tr>

      </tbody>

    </table>
  </div>
</Container>

  <!-- REGISTRATION -->
  <Container>
    <Heading2 text="Registration" />
    <ButtonContainer>
      <Button
        href="https://forms.gle/ekTsCgvVCwPL22EC6"
        class="fa-solid fa-user-plus"
        title="Conference Registration"
        description="Click this button to register."
      />
    </ButtonContainer>
  </Container>

  <!-- CONTACT -->
  <Container>
    <Heading2 text="Contact Us" />
    <ContactContainer>
      <Contact
        media="WhatsApp (Mrs. Ratih)"
        class="fa-brands fa-whatsapp"
        text="+62 823-2866-8422"
        href="#"
      />
      <Contact
        media="WhatsApp (Mr. Ricky)"
        class="fa-brands fa-whatsapp"
        text="+62 812-8797-1081"
        href="#"
      />
    </ContactContainer>
  </Container>

</Layout>