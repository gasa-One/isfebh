---
import Jumbotron from "../layouts/partials/Jumbotron.astro";
import Paragraph from "../layouts/components/Paragraph.astro";
import Layout from "../layouts/partials/Layout.astro";
import Container from "../layouts/partials/Container.astro";
import ContactContainer from "../layouts/components/ContactContainer.astro";
import Contact from "../layouts/components/ContactSub.astro";
import Heading2 from "../layouts/components/Heading2.astro";
import DateIndex from "../layouts/components/DateIndex.astro";
import Button from "../layouts/helpers/Button.astro";
import ButtonContainer from "../layouts/helpers/ButtonContainer.astro";
---

<Layout title="Home">
	<!-- <PopUp/> -->
	<Jumbotron src="/jumbotron/tes.webp" />
	<Container>
		<Paragraph
			text={`The Faculty of Economics, Business, and Humanities of Universitas Trilogi proudly presents The 2nd International Seminar on Business, Economics, and Humanities with the theme “International Conference on Sustainable Development, Business, and Education Transformation in the Global Digital Era.” This international seminar is organized as an academic and professional platform that brings together scholars, researchers, practitioners, students, and policymakers from various countries to discuss emerging issues, challenges, and opportunities in the areas of sustainable development, digital business transformation, economics, humanities, and education in the global era.
            The seminar aims to promote the exchange of knowledge, innovative ideas, and research findings that contribute to the advancement of science and professional practices in business, economics, humanities, and education. Through interdisciplinary discussions and international collaboration, this event is expected to encourage the development of sustainable strategies, strengthen digital transformation initiatives, and foster innovative solutions to global challenges faced by society, organizations, and educational institutions.
            Furthermore, the seminar seeks to strengthen international academic networking and research collaboration among universities, industries, and institutions worldwide. It also aims to support scientific publication opportunities, improve academic quality, and encourage participants to contribute actively to sustainable development and global transformation in the digital age.`}
    />

	<Container>
		<Heading2 text="Timeline" />
		<DateIndex />
	</Container>
	<Container>
		<div class="flex justify-center align-items-center flex-col">
			<div class="flex justify-center">
				<img class="w-[3/6] lg:w-1/2" src="/flyer.png" alt="" />
			</div>
			<ButtonContainer>
				<a
					href="/flyer.png"
					class="relative hover:bg-[#d1d5db] rounded-full border-amber-300 cursor-pointer block py-3 px-6 -mb-px border border-gray-300 no-underline w-fill flex gap-3 py-3 items-center animate__animated"
					aria-current="true"
					download=""
				>
					<i class="fa-solid fa-download"></i>
					<div class="flex gap-2 w-full justify-between">
						<div>
							<h6 class="mb-0 text-sm lg:text-base">Download Poster</h6>
							<p class="mb-0 opacity-75 text-xs lg:text-base">
								Click this button to download poster.
							</p>
						</div>
					</div>
				</a>
			</ButtonContainer>
		</div>
	</Container>
	<Container>
		<Heading2 text="Contact Us" />
		<ContactContainer>
	  <Contact
        media="WhatsApp (Mrs. Ratih)"
        class="fa-brands fa-whatsapp"
        text="+62 823-2866-8422"
        href="#"
      />
      <Contact
        media="WhatsApp (Mr. Ricky)"
        class="fa-brands fa-whatsapp"
        text="+62 812-8797-1081"
        href="#"
      />
      <Contact
        media="Email"
        class="fa-regular fa-envelope"
        text="internationalseminar@trilogi.ac.id"
        href="mailto:internationalseminar@trilogi.ac.id"
      />
		</ContactContainer>
	</Container>
</Layout>
