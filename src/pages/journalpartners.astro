---
import Layout from "../layouts/partials/Layout.astro";
import Container from "../layouts/partials/Container.astro";
import Heading2 from "../layouts/components/Heading2.astro";
import HeadingMini from "../layouts/components/HeadingMini.astro";

const journals = [
  {
    nama: "Dinasti International Journal of Education Management and Social Sciense (DIJEMSS)",
    logo: "/jumbotron/dijemss.webp",
    website: "https://dinastipub.org/DIJEMSS",
    afiliasi: "Dinasti Publisher - DINASTI - UNWIM, Indonesia",
    index: "Sinta",
    tier: "S2",
    scope: "Education management, curriculum, educational technology, teaching methods, teacher education, and social sciences in education"
  },
  {
    nama: "Greenation International Journal of Economics and Accounting (GIJEA)",
    logo: "/jumbotron/gijea.webp",
    website: "https://research.e-greenation.org/GIJEA",
    afiliasi: "Publisher information under verification",
    index: "Sinta",
    tier: "S2",
    scope: "Business, economics, finance, accounting, taxation, banking, international economics, entrepreneurship, public administration, and economic development"
  },
  {
    nama: "Dinasti International Journal of Economics, Finance & Accounting",
    logo: "/jumbotron/dijefa.webp",
    website: "https://dinastipub.org/DIJEFA",
    afiliasi: "Dinasti Publisher - DINASTI - UNWIM, Indonesia",
    index: "Sinta",
    tier: "S3",
    scope: "Accounting, finance, taxation, auditing, corporate governance, business management, entrepreneurship, public administration, and economic development"
  },
  {
    nama: "Jurnal Ilmu Manajemen Terapan (JIMT)",
    logo: "/jumbotron/jimt.webp",
    website: "https://dinastirev.org/index.php/JIMT",
    afiliasi: "Dinasti Review -  DINASTI - UNWIM, Indonesia",
    index: "Sinta",
    tier: "S3",
    scope: "Business, economics, entrepreneurship, human resource management, marketing, operations, finance, digital business systems, and information technology management"
  },
  {
    nama: "Journal of Accounting and Finance Management (JAFM)",
    logo: "/jumbotron/jafm.webp",
    website: "https://dinastires.org/JAFM",
    afiliasi: "Publisher information under verification",
    index: "Sinta",
    tier: "S3",
    scope: "Accounting, auditing, taxation, finance, banking, corporate governance, Islamic accounting, information systems, and sustainability reporting"
  },
  {
    nama: "Jurnal Manajemen Pendidikan dan Ilmu Sosial (JMPIS)",
    logo: "/jumbotron/jmpis.webp",
    website: "https://dinastirev.org/JMPIS",
    afiliasi: "Dinasti Review - DINASTI - UNWIM, Indonesia",
    index: "Sinta",
    tier: "S3",
    scope: "Educational management, curriculum, learning process, education policy, educational leadership, social sciences, humanities, and multidisciplinary aducation studies"
  },
  {
    nama: "Dinasti International Journal of Digital Business Management (DIJDBM)",
    logo: "/jumbotron/dijdbm.webp",
    website: "https://dinastipub.org/DIJDBM",
    afiliasi: "Dinasti Publisher ecosystem - DINASTI - Indonesia",
    index: "Sinta",
    tier: "S5",
    scope: "Information management, digital libraries, knowledge systems, data and content management, digital publishing, information systems, and digital enterprise technologies"
  },
  {
    nama: "Dinasti International Journal of Management Science (DIJMS)",
    logo: "/jumbotron/dijms.webp",
    website: "https://dinastipub.org/index.php/DIJMS",
    afiliasi: "Dinasti Publisher - DINASTI - UNWIM, Indonesia",
    index: "Sinta",
    tier: "S5",
    scope: "Business, economics, finance, accounting, management, marketing, human resources, operations, supply chain, and organizational management systems"
  }
];
---

<Layout title="Journal Partners">
  <Container>
    <Heading2 text="Journal Partners" />

    <!-- GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 my-6">

  {
    journals.map(item => (
      <div class="group w-full h-full bg-white rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition duration-300 overflow-hidden border flex flex-col">

        <!-- LOGO -->
        <div class="h-[160px] flex items-center justify-center bg-gray-50 p-4">
          <img 
            class="max-h-full object-contain group-hover:scale-110 transition duration-300"
            src={item.logo} 
            alt={item.nama}
          />
        </div>

        <!-- CONTENT -->
        <div class="p-4 text-center flex flex-col flex-1">

          <!-- TITLE -->
          <a href={item.website} target="_blank">
            <h5 class="font-bold text-lg hover:text-blue-600 transition mb-2">
              {item.nama}
            </h5>
          </a>

          <!-- AFILIASI -->
          <p class="text-sm text-gray-500 mb-2">
            {item.afiliasi}
          </p>

          <!-- BADGE -->
          <div class="flex justify-center gap-2 flex-wrap mb-2">

            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700 font-medium">
              {item.index}
            </span>

            <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-700 font-medium">
              {item.tier}
            </span>

          </div>

          <!-- SCOPE -->
          <p class="text-xs text-gray-600 mt-auto">
            {item.scope}
          </p>

        </div>

      </div>
    ))
  }

</div>
    <HeadingMini text="more to be announce" />

  </Container>
</Layout>