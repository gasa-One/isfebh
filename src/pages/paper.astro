---
import Jumbotron from "../layouts/partials/Jumbotron.astro";
import Paragraph from "../layouts/components/Paragraph.astro";
import Layout from "../layouts/partials/Layout.astro";
import Container from "../layouts/partials/Container.astro";
import Contact from "../layouts/components/ContactSub.astro";
import ContactContainer from "../layouts/components/ContactContainer.astro";
import Heading2 from "../layouts/components/Heading2.astro";
import Heading3 from "../layouts/components/Heading3.astro";
import PricePaper from "../layouts/components/PricePaper.astro";
import DatePaper from "../layouts/components/DatePaper.astro";
import SORContainer from "../layouts/components/SORContainer.astro";
import SOR from "../layouts/components/SOR.astro";
import Button from "../layouts/helpers/Button.astro";
import ButtonContainer from "../layouts/helpers/ButtonContainer.astro";
---

<Layout title="Call for Paper">
    <Jumbotron 
    src="/jumbotron/seminar1.png" />
    <Container>
        <Paragraph
            text="As a form of contribution to the development of accounting science in Indonesia, it was jointly initiated by the Association of Certified Fraud Examiners (ACFE) Indonesia Chapter and the Association of Public Sector Accounting Educators (APSAE) which was also supported by the Indonesian Institute of Accountants (IAI) Compartment of Accountants Educators for DKI Jakarta Region. As well as during this conference trip, it was also held in collaboration with SINTA Accredited Journals, Index Copernicus, ProQuest, DOAJ, RePec, Google Scholar."
        />
    </Container>
    <Container>
  <Heading2 text="Conference Posters" />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-6">

    <!-- POSTER 1 -->
    <div class="bg-white rounded-xl shadow-lg p-4 flex flex-col items-center text-center hover:-translate-y-2 transition duration-300">
      <img src="/jumbotron/Flyer1.png" class="rounded-lg mb-4" />

      <h3 class="text-lg font-semibold mb-2">
        ACCOUNTING
      </h3>

      <a
        href="https://linktr.ee/inncafa"
        class="mt-2 bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-full text-sm flex items-center gap-2"
      >
        <i class="fa-solid fa-user-plus"></i>
        Submit Paper
      </a>
    </div>

    <!-- POSTER 2 -->
    <div class="bg-white rounded-xl shadow-lg p-4 flex flex-col items-center text-center hover:-translate-y-2 transition duration-300">
      <img src="/jumbotron/Flyer.png" class="rounded-lg mb-4" />

      <h3 class="text-lg font-semibold mb-2">
        MANAGEMENT & ECONOMIC DEVELOPMENT
      </h3>

      <a
        href="https://linktr.ee/SubmitManagement"
        class="mt-2 bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-full text-sm flex items-center gap-2"
      >
        <i class="fa-solid fa-user-plus"></i>
        Submit Paper
      </a>
    </div>

    <!-- POSTER 3 -->
    <div class="bg-white rounded-xl shadow-lg p-4 flex flex-col items-center text-center hover:-translate-y-2 transition duration-300">
      <img src="/jumbotron/Flyer.png" class="rounded-lg mb-4" />

      <h3 class="text-lg font-semibold mb-2">
        EDUCATION
      </h3>

      <a
        href="https://linktr.ee/SubmitEducation"
        class="mt-2 bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-full text-sm flex items-center gap-2"
      >
        <i class="fa-solid fa-user-plus"></i>
        Submit Paper
      </a>
    </div>

  </div>
</Container>
    <Container>
        <Heading2 text="Timeline" />
        <DatePaper />
    </Container>
    <!-- <Container>
        <Heading2 text="Guideline" />
        <TableGuideline />
    </Container> -->
    <Container>
        <Heading2 text="Price" />
        <PricePaper />
    </Container>
    <Container>
        <Heading2 text="Contact Us" />
        <ContactContainer>
            <Contact
        media="WhatsApp (Mrs. Ratih)"
        class="fa-brands fa-whatsapp"
        text="+62 823-2866-8422"
        href="https://wa.me/6282328668422"
      />
      <Contact
        media="WhatsApp (Mr. Ricky)"
        class="fa-brands fa-whatsapp"
        text="+62 812-8797-1081"
        href="https://wa.me/6281287971081"
      />
      <Contact
        media="Email"
        class="fa-regular fa-envelope"
        text="internationalseminar@trilogi.ac.id"
        href="#"
      />
        </ContactContainer>
    </Container>
</Layout>
