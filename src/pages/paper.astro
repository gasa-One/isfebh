    <Container>
        <Heading2 text="Submission and Registration" />
        <ButtonContainer>
            <Button
                href="/paper/submission"
                class="fa-solid fa-user-plus"
                title="Paper Submission"
                description="Click this button to submit your paper."
            />
        </ButtonContainer>
        <ButtonContainer>
            <Button
                href="/paper/register"
                class="fa-solid fa-user-plus"
                title="Paper Registration"
                description="Click this button to registration call for paper."
            />
        </ButtonContainer>
    </Container>
	
    <Container>
        <Heading2 text="Paper Template" />
            <ButtonContainer>
                <Heading3
                    text="International"
                />
                <Button
                    href="https://drive.google.com/uc?export=download&id=1xkoK4UQxPrD0dIAhE5x3UwCHTAfpedc5"
                    class="fa-solid fa-download"
                    title="Abstract Template"
                    description="Click this button to download Abstract Template."
                />
            </ButtonContainer>
            <ButtonContainer>
                <Button
                    href="https://drive.google.com/uc?export=download&id=1XJPSratas5NUiJjqdDst0C441QH1jHVZ "
                    class="fa-solid fa-download"
                    title="Full Paper Template"
                    description="Click this button to download Full Paper Template."
                />
            </ButtonContainer>
            <ButtonContainer>
                <Heading3
                    text="National"
                />
                <Button
                    href="https://drive.google.com/uc?export=download&id=1dVOGJ8wriRZFRpNodTjI-y5uhAY81Q32 "
                    class="fa-solid fa-download"
                    title="Abstract Template"
                    description="Click this button to download Abstract Template."
                />
            </ButtonContainer>
            <ButtonContainer>
                <Button
                    href="https://drive.google.com/uc?export=download&id=1Bfyo2FBobkycBCslRj9fBnu3I0q2gx_R"
                    class="fa-solid fa-download"
                    title="Full Paper Template"
                    description="Click this button to download Full Paper Template."
                />
            </ButtonContainer>
    </Container>
	
    <Container>
        <Heading2 text="Contact Us" />
        <ContactContainer>
            <Contact
            media="WhatsApp"
            class="fa-brands fa-whatsapp fa-2xl py-3 text-black"
            text="+62 823-2866-8422 (Ms. Ratih)"
            href="https://wa.me/6282328668422"
        />

        <Contact
            media="WhatsApp"
            class="fa-brands fa-whatsapp fa-2xl py-3 text-black"
            text="+62 812-8979-1081 (Mr. Ricky)"
            href="https://wa.me/6281287971081"
        />
        </ContactContainer>
    </Container>
	
</Layout>

<style>
.timeline-section {
  text-align: center;
  padding: 40px 20px;
}

.timeline {
  position: relative;
  max-width: 800px;
  margin: auto;
}

.timeline::after {
  content: '';
  position: absolute;
  width: 2px;
  background: #ccc;
  top: 0;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}

.timeline-item {
  padding: 20px;
  position: relative;
  width: 50%;
}

.timeline-item.left {
  left: 0;
  text-align: right;
}

.timeline-item.right {
  left: 50%;
  text-align: left;
}

.timeline-item::after {
  content: "✔";
  position: absolute;
  top: 20px;
  width: 20px;
  height: 20px;
  background: black;
  color: white;
  border-radius: 50%;
  text-align: center;
  font-size: 12px;
  line-height: 20px;
}

.timeline-item.left::after {
  right: -10px;
}

.timeline-item.right::after {
  left: -10px;
}

.content {
  padding: 10px 20px;
}

@media (max-width: 768px) {
  .timeline-item {
    width: 100%;
    left: 0 !important;
    text-align: left;
    padding-left: 40px;
  }

  .timeline::after {
    left: 20px;
  }

  .timeline-item::after {
    left: 10px;
  }
}

.price-section {
  margin-top: 50px;
}

.price-table {
  width: 100%;
  max-width: 800px;
  margin: auto;
  border-collapse: collapse;
}

.price-table th {
  text-align: left;
  padding: 12px;
  font-weight: bold;
  border-bottom: 2px solid #ddd;
}

.price-table td {
  padding: 12px;
  border-bottom: 1px solid #eee;
}

.section-row td {
  font-weight: bold;
  padding-top: 20px;
  border-bottom: none;
}
</style>