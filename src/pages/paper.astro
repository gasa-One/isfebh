            <SOR
                sor="Financial Accounting and Capital Markets (FACM)"
                class="fa-solid fa-money-bill-trend-up fa-2xl pb-4"
            />
            <SOR
                sor="Management and Behavioral Accounting (MBA)"
                class="fa-solid fa-bars-progress fa-2xl pb-4 h-1/2"
            />
            <SOR
                sor="Information Systems, Auditing, and Professional Ethics (SAPE)"
                class="fa-solid fa-user fa-2xl pb-4"
            />
            <SOR
                sor="Taxation (TAX)"
                class="fa-solid fa-star-and-crescent fa-2xl pb-4"
            />
            <SOR
                sor="Sharia Accounting (SRA)"
                class="fa-solid fa-building-shield fa-2xl pb-4"
            />
            <SOR
                sor="Governance and Sustainability Accounting (GSA)"
                class="fa-solid fa-graduation-cap fa-2xl pb-4"
            />
            <SOR
                sor="Fraud and Forensic Accounting (FFA)"
                class="fa-solid fa-sitemap fa-2xl pb-4"
            />
            <SOR
                sor="Public Sector Accounting (PSA)"
                class="fa-solid fa-users-between-lines fa-2xl pb-4"
            />
			<SOR
                sor="Accounting Education (AEd)"
                class="fa-solid fa-users-between-lines fa-2xl pb-4"
            />
        </SORContainer>
		<Heading2 text="International Conference on Education, Learning, and Digital Transformation (ICELDT 2026)"/>
        <SORContainer>
            <SOR
                sor="Child Development and Learning"
                class="fa-solid fa-money-bill-trend-up fa-2xl pb-4"
            />
            <SOR
                sor="Early Childhood Education"
                class="fa-solid fa-bars-progress fa-2xl pb-4 h-1/2"
            />
            <SOR
                sor="Elementary Education"
                class="fa-solid fa-user fa-2xl pb-4"
            />
            <SOR
                sor="Digital Pedagody, Artificial Intelligence and Innovative Learning"
                class="fa-solid fa-star-and-crescent fa-2xl pb-4"
            />
            <SOR
                sor="Inclusive Digital Education"
                class="fa-solid fa-building-shield fa-2xl pb-4"
            />
            <SOR
                sor="Digital Assessment in Early Childhood and/or Primary Education"
                class="fa-solid fa-graduation-cap fa-2xl pb-4"
            />
            <SOR
				sor="Child Protection and Ethical use of digital technologies"
				class="fa-solid fa-receipt fa-2xl pb-4" />
            <SOR
                sor="Teacher readiness for digital transformation"
                class="fa-solid fa-sitemap fa-2xl pb-4"
            />
            <SOR
                sor="Family Engagement in Digital Learning"
                class="fa-solid fa-users-between-lines fa-2xl pb-4"
            />
            <SOR
                sor="School-family partnerships"
                class="fa-solid fa-users-between-lines fa-2xl pb-4"
            />
        </SORContainer>
		<Heading2 text="International Conference on Management, Economics, and Digital Business (ICMEDB)"/>
        <SORContainer>
            <SOR
                sor="Strategic and innovation management"
                class="fa-solid fa-money-bill-trend-up fa-2xl pb-4"
            />
            <SOR
                sor="Digital entrepreneurship and digital economics"
                class="fa-solid fa-bars-progress fa-2xl pb-4 h-1/2"
            />
            <SOR
                sor="Entrepreneurship, marketing management and consumber behavior"
                class="fa-solid fa-user fa-2xl pb-4"
            />
            <SOR
                sor="Organizational behavior and human resources studies"
                class="fa-solid fa-star-and-crescent fa-2xl pb-4"
            />
            <SOR
                sor="Industrial economics and development economics"
                class="fa-solid fa-building-shield fa-2xl pb-4"
            />
            <SOR
                sor="Financial management and financial economics"
                class="fa-solid fa-graduation-cap fa-2xl pb-4"
            />
            <SOR 
				sor="Open economy and international trade"
