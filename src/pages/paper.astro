---
import Jumbotron from "../layouts/partials/Jumbotron.astro";
import Paragraph from "../layouts/components/Paragraph.astro";
import Layout from "../layouts/partials/Layout.astro";
import Container from "../layouts/partials/Container.astro";
import Contact from "../layouts/components/ContactSub.astro";
import ContactContainer from "../layouts/components/ContactContainer.astro";
import Heading2 from "../layouts/components/Heading2.astro";
import Heading3 from "../layouts/components/Heading3.astro";
import SORContainer from "../layouts/components/SORContainer.astro";
import SOR from "../layouts/components/SOR.astro";
import Button from "../layouts/helpers/Button.astro";
import ButtonContainer from "../layouts/helpers/ButtonContainer.astro";

const events = [
  { date: "July 20th, 2026", title: "Paper Submission Deadline", side: "left" },
  { date: "August 7th, 2026", title: "Paper Acceptance Announcement", side: "right" },
  { date: "August 14th, 2026", title: "Registration & Payment Deadline", side: "left" },
  { date: "August 19th, 2026", title: "Conference Day", side: "right" }
];
---

<Layout title="Call for Paper">

  <Jumbotron src="/jumbotron/paper-3.webp" />

  <Container>
    <Paragraph text="As a form of contribution to the development of accounting science in Indonesia, this conference is supported by ACFE, APSAE, IAI, and indexed journals such as SINTA, DOAJ, ProQuest, and Google Scholar." />
  </Container>

  <Container>
    <Heading2 text="INCAFA" />
    <SORContainer>
      <SOR sor="Financial Accounting" class="fa-solid fa-money-bill-trend-up" />
      <SOR sor="Management Accounting" class="fa-solid fa-bars-progress" />
      <SOR sor="Information Systems" class="fa-solid fa-user" />
      <SOR sor="Taxation" class="fa-solid fa-star-and-crescent" />
    </SORContainer>

    <Heading2 text="ICELDT 2026" />
    <SORContainer>
      <SOR sor="Child Development" class="fa-solid fa-user" />
      <SOR sor="Digital Learning" class="fa-solid fa-graduation-cap" />
      <SOR sor="AI in Education" class="fa-solid fa-robot" />
    </SORContainer>

    <Heading2 text="ICMEDB" />
    <SORContainer>
      <SOR sor="Strategic Management" class="fa-solid fa-chart-line" />
      <SOR sor="Digital Business" class="fa-solid fa-globe" />
      <SOR sor="Financial Economics" class="fa-solid fa-coins" />
    </SORContainer>
  </Container>

  <Container>
    <Heading2 text="Timeline" />
    <div>
      {events.map((event) => (
        <div>
          <p>{event.date}</p>
          <h3>{event.title}</h3>
        </div>
      ))}
    </div>
  </Container>

  <Container>
    <Heading2 text="Registration" />
    <ButtonContainer>
      <Button
        href="/paper/submission"
        class="fa-solid fa-user-plus"
        title="Submit Paper"
        description="Submit your paper here"
      />
    </ButtonContainer>
  </Container>

  <Container>
    <Heading2 text="Contact" />
    <ContactContainer>
      <Contact
        media="WhatsApp"
        class="fa-brands fa-whatsapp"
        text="+62 823-2866-8422"
        href="https://wa.me/6282328668422"
      />
      <Contact
        media="WhatsApp"
        class="fa-brands fa-whatsapp"
        text="+62 812-8979-1081"
        href="https://wa.me/6281287971081"
      />
    </ContactContainer>
  </Container>

</Layout>