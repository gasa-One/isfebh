---
import Jumbotron from "../layouts/partials/Jumbotron.astro";
import Paragraph from "../layouts/components/Paragraph.astro";
import Layout from "../layouts/partials/Layout.astro";
import Container from "../layouts/partials/Container.astro";
import Contact from "../layouts/components/ContactSub.astro";
import ContactContainer from "../layouts/components/ContactContainer.astro";
import Heading2 from "../layouts/components/Heading2.astro";
import Heading3 from "../layouts/components/Heading3.astro";
import PricePaper from "../layouts/components/PricePaper.astro";
import DatePaper from "../layouts/components/DatePaper.astro";
import SORContainer from "../layouts/components/SORContainer.astro";
import SOR from "../layouts/components/SOR.astro";
import Button from "../layouts/helpers/Button.astro";
import ButtonContainer from "../layouts/helpers/ButtonContainer.astro";
---

<Layout title="Call for Paper">
    <Jumbotron 
    src="/jumbotron/seminar1.png" />
    <Container>
        <Paragraph
  text={`The call for papers of The 2nd International Conference on Sustainable Development, Business, and Education Transformation in the Global Digital Era organized by the Faculty of Economics, Business, and Humanities of Universitas Trilogi aims to provide an international academic platform for researchers, lecturers, practitioners, students, and policymakers to disseminate research findings, exchange knowledge, and discuss contemporary issues in the fields of accounting, management, economics, business, and education.

This conference is collaboratively conducted through three major international conference tracks: International Conference on Accounting and Fraud Auditing (INCAFA) in the field of accounting, International Conference on Management, Economics, and Digital Business in the fields of management and economics, and International Conference on Education, Learning, and Digital Transformation in the field of education. Through these collaborative call paper activities, participants are encouraged to contribute innovative ideas, empirical studies, and practical solutions that address the challenges of sustainable development and digital transformation in the global era.

The primary objective of the call for papers is to strengthen interdisciplinary and international academic collaboration, encourage high-quality scientific publications, and support the development of knowledge and professional practices that contribute to sustainable economic growth, transparent governance, digital business innovation, and the advancement of education systems. In addition, the conference seeks to build strong research networks among universities, industries, and institutions at both national and international levels.`}
/>
    </Container>
    <Container>
  <Heading2 text="Conference Posters" />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-6">

    <!-- POSTER 1 -->
    <div class="bg-white rounded-xl shadow-lg p-4 flex flex-col items-center text-center hover:-translate-y-2 transition duration-300">
      <img src="/jumbotron/flyer1.png" class="rounded-lg mb-4" />

      <h3 class="text-lg font-semibold mb-2">
        ACCOUNTING
      </h3>

      <a
        href="https://linktr.ee/inncafa"target="_blank"
        class="mt-2 bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-full text-sm flex items-center gap-2"
      >
        <i class="fa-solid fa-user-plus"></i>
        Submit Paper
      </a>
    </div>

    <!-- POSTER 2 -->
    <div class="bg-white rounded-xl shadow-lg p-4 flex flex-col items-center text-center hover:-translate-y-2 transition duration-300">
      <img src="/jumbotron/flyer2.png" class="rounded-lg mb-4" />

      <h3 class="text-lg font-semibold mb-2">
        MANAGEMENT
        <br> ECONOMIC DEVELOPMENT
      </h3>

      <a
        href="https://linktr.ee/SubmitManagement"target="_blank"
        class="mt-2 bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-full text-sm flex items-center gap-2"
      >
        <i class="fa-solid fa-user-plus"></i>
        Submit Paper
      </a>
    </div>

    <!-- POSTER 3 -->
    <div class="bg-white rounded-xl shadow-lg p-4 flex flex-col items-center text-center hover:-translate-y-2 transition duration-300">
      <img src="/jumbotron/flyer3.png" class="rounded-lg mb-4" />

      <h3 class="text-lg font-semibold mb-2">
        EDUCATION
      </h3>

      <a
        href="https://linktr.ee/SubmitEducation"target="_blank"
        class="mt-2 bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-full text-sm flex items-center gap-2"
      >
        <i class="fa-solid fa-user-plus"></i>
        Submit Paper
      </a>
    </div>

  </div>
</Container>
    <Container>
        <Heading2 text="Timeline" />
        <DatePaper />
    </Container>
    <!-- <Container>
        <Heading2 text="Guideline" />
